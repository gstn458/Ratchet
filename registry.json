{
  "schema_version": 1,
  "registry_version": "2026.10.0",
  "description": "Ratchet algorithm registry. Every entry is a claim about cryptography; see CONTRIBUTING.md before changing one.",
  "field_notes": {
    "quantum": {
      "broken": "Shor's algorithm breaks it outright. Must migrate.",
      "reduced": "Grover halves the effective security. Usually fine at higher parameter sizes, but worth recording.",
      "safe": "A NIST post-quantum standard."
    },
    "classical": {
      "broken": "Already broken today, independent of quantum.",
      "ok": "Not broken classically."
    },
    "nist_quantum_security_level": "Value written to CycloneDX nistQuantumSecurityLevel for each quantum status."
  },
  "nist_quantum_security_level": {
    "broken": 0,
    "reduced": 1,
    "safe": 3
  },
  "algorithms": {
    "RSA": {
      "primitive": "pke",
      "quantum": "broken",
      "classical": "ok",
      "oid": "1.2.840.113549.1.1.1",
      "functions": [
        "keygen",
        "encrypt",
        "decrypt",
        "sign",
        "verify"
      ],
      "replacement": "ML-KEM-768 for key establishment, ML-DSA-65 for signatures",
      "why": "Shor's algorithm factors the modulus in polynomial time."
    },
    "ECDSA": {
      "primitive": "signature",
      "quantum": "broken",
      "classical": "ok",
      "oid": "1.2.840.10045.4",
      "functions": [
        "keygen",
        "sign",
        "verify"
      ],
      "replacement": "ML-DSA-65 (FIPS 204), or SLH-DSA if you need hash-based",
      "why": "Shor's algorithm solves the discrete log on the curve."
    },
    "ECDH": {
      "primitive": "key-agree",
      "quantum": "broken",
      "classical": "ok",
      "oid": "1.3.132.1.12",
      "functions": [
        "keygen",
        "keyderive"
      ],
      "replacement": "ML-KEM-768, ideally hybrid X25519+ML-KEM during transition",
      "why": "Shor's algorithm solves the discrete log on the curve."
    },
    "Ed25519": {
      "primitive": "signature",
      "quantum": "broken",
      "classical": "ok",
      "oid": "1.3.101.112",
      "functions": [
        "keygen",
        "sign",
        "verify"
      ],
      "replacement": "ML-DSA-65 (FIPS 204)",
      "why": "Edwards-curve discrete log falls to Shor's algorithm."
    },
    "X25519": {
      "primitive": "key-agree",
      "quantum": "broken",
      "classical": "ok",
      "oid": "1.3.101.110",
      "functions": [
        "keygen",
        "keyderive"
      ],
      "replacement": "hybrid X25519+ML-KEM-768, then ML-KEM alone",
      "why": "Curve25519 discrete log falls to Shor's algorithm."
    },
    "DH": {
      "primitive": "key-agree",
      "quantum": "broken",
      "classical": "ok",
      "oid": "1.2.840.113549.1.3.1",
      "functions": [
        "keygen",
        "keyderive"
      ],
      "replacement": "ML-KEM-768 (FIPS 203)",
      "why": "Shor's algorithm solves the finite-field discrete log."
    },
    "DSA": {
      "primitive": "signature",
      "quantum": "broken",
      "classical": "ok",
      "oid": "1.2.840.10040.4.1",
      "functions": [
        "keygen",
        "sign",
        "verify"
      ],
      "replacement": "ML-DSA-65 (FIPS 204)",
      "why": "Shor's algorithm solves the finite-field discrete log."
    },
    "MD5": {
      "primitive": "hash",
      "quantum": "reduced",
      "classical": "broken",
      "oid": "1.2.840.113549.2.5",
      "functions": [
        "digest"
      ],
      "replacement": "SHA-256 or SHA-3, or BLAKE2 for non-compliance use",
      "why": "Collisions are practical today. Quantum is not the problem here."
    },
    "SHA-1": {
      "primitive": "hash",
      "quantum": "reduced",
      "classical": "broken",
      "oid": "1.3.14.3.2.26",
      "functions": [
        "digest"
      ],
      "replacement": "SHA-256 or SHA-3",
      "why": "Chosen-prefix collisions demonstrated in 2020. Retire it."
    },
    "DES": {
      "primitive": "block-cipher",
      "quantum": "reduced",
      "classical": "broken",
      "oid": "1.3.14.3.2.7",
      "functions": [
        "encrypt",
        "decrypt"
      ],
      "replacement": "AES-256-GCM",
      "why": "56-bit key. Brute-forced on commodity hardware."
    },
    "3DES": {
      "primitive": "block-cipher",
      "quantum": "reduced",
      "classical": "broken",
      "oid": "1.2.840.113549.3.7",
      "functions": [
        "encrypt",
        "decrypt"
      ],
      "replacement": "AES-256-GCM",
      "why": "Sweet32 birthday attacks. Deprecated by NIST after 2023."
    },
    "RC4": {
      "primitive": "stream-cipher",
      "quantum": "reduced",
      "classical": "broken",
      "oid": "1.2.840.113549.3.4",
      "functions": [
        "encrypt",
        "decrypt"
      ],
      "replacement": "AES-256-GCM or ChaCha20-Poly1305",
      "why": "Biased keystream. Prohibited in TLS since RFC 7465."
    },
    "AES": {
      "primitive": "block-cipher",
      "quantum": "reduced",
      "classical": "ok",
      "oid": "2.16.840.1.101.3.4.1",
      "functions": [
        "encrypt",
        "decrypt"
      ],
      "replacement": "AES-256 if currently AES-128",
      "why": "Grover halves effective key length. AES-256 stays at 128-bit margin."
    },
    "SHA-256": {
      "primitive": "hash",
      "quantum": "reduced",
      "classical": "ok",
      "oid": "2.16.840.1.101.3.4.2.1",
      "functions": [
        "digest"
      ],
      "replacement": "no action needed",
      "why": "Grover gives a quadratic speedup only. Still acceptable."
    },
    "ML-KEM": {
      "primitive": "kem",
      "quantum": "safe",
      "classical": "ok",
      "oid": "2.16.840.1.101.3.4.4",
      "functions": [
        "keygen",
        "encapsulate",
        "decapsulate"
      ],
      "replacement": "none",
      "why": "FIPS 203. Module-lattice KEM."
    },
    "ML-DSA": {
      "primitive": "signature",
      "quantum": "safe",
      "classical": "ok",
      "oid": "2.16.840.1.101.3.4.3",
      "functions": [
        "keygen",
        "sign",
        "verify"
      ],
      "replacement": "none",
      "why": "FIPS 204. Module-lattice signature."
    }
  }
}
